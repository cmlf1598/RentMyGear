# Copy to .env.local and fill in. The server refuses to start if any of the
# required values are missing or malformed (validated in src/config/env.ts).

# --- Google Cloud Storage (AI-generated image persistence) -------------------
# Globally unique bucket name: 3-63 chars, lowercase letters, digits, - _ .
GCS_BUCKET_NAME=rent-my-gear-images
# Project ID (not the name/number), e.g. rent-my-gear-123456
GCS_PROJECT_ID=your-gcp-project-id
# Path (absolute or relative to the project root) to a service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# Optional: bucket location used by setup_gcs.py when creating the bucket
# GCS_LOCATION=US

# --- Nano Banana Pro (gemini-3-pro-image-preview) ------------------------------
# Gemini API key: https://aistudio.google.com/apikey
NANO_BANANA_API_KEY=
# Optional model override
# NANO_BANANA_MODEL=gemini-3-pro-image-preview

# --- Unsplash (only used by `npm run seed:images`, not by the app) ------------
# Access key: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# --- Debugging -----------------------------------------------------------------
# debug | info | warn | error (default: debug in dev, info in production)
# LOG_LEVEL=debug
